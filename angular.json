{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "coreui-free-angular-admin-template": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/proyecto-para-nube",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init", "zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "preserveSymlinks": true,
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "src/scss/styles.scss",
              "node_modules/dropzone/dist/dropzone.css",
              "node_modules/ngx-lightbox/lightbox.css",
              "node_modules/quill/dist/quill.snow.css",
              "node_modules/quill/dist/quill.bubble.css",
              "node_modules/@fancyapps/ui/dist/fancybox/fancybox.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ],
            "scripts": [
              "node_modules/@fancyapps/ui/dist/fancybox/fancybox.umd.js"
            ],
            "allowedCommonJsDependencies": [],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": []
              }
            }
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "./src/app/environments/environment.ts",
                  "with": "./src/app/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "7mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "100kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "coreui-free-angular-admin-template:build:production"
            },
            "development": {
              "buildTarget": "coreui-free-angular-admin-template:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "coreui-free-angular-admin-template:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/scss/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "catalog-module": {
              "tsConfig": "tsconfig.catalog-tests.json",
              "watch": false,
              "browsers": "ChromeHeadless",
              "include": [
                "src/app/views/dashboard/products/product-shopify-bulk/product-shopify-bulk.spec.ts",
                "src/app/views/dashboard/products/product-index/product-duplicate.spec.ts",
                "src/app/views/dashboard/products/product-index-page/product-sort.spec.ts",
                "src/app/views/dashboard/products/variants/variant-search/variant-search.component.spec.ts"
              ]
            },
            "production-module": {
              "tsConfig": "tsconfig.production-tests.json",
              "watch": false,
              "browsers": "ChromeHeadless",
              "include": [
                "src/app/views/dashboard/users/shared/contact-workflow.spec.ts",
                "src/app/views/dashboard/manufactures/orders/purchase-order-ui.spec.ts",
    "src/app/views/dashboard/payments/payment-workflow.spec.ts",
                "src/app/views/dashboard/kardex/kardex-history/kardex-history.component.spec.ts",
                "src/app/views/dashboard/inventory-receptions/inventory-reception-index/inventory-reception-index.component.spec.ts",
                "src/app/views/dashboard/kardex/kardex-index/kardex-index.component.spec.ts",
                "src/app/views/dashboard/kardex/kardex-index-selected/kardex-index-selected.component.spec.ts",
                "src/app/views/dashboard/kardex/kardex-register-in/kardex-register-in.component.spec.ts",
                "src/app/views/shared/components/delivery-tracking/delivery-tracking.spec.ts",
                "src/app/views/dashboard/manufactures/productions/production-stages/production-stages.spec.ts",
                "src/app/views/dashboard/manufactures/productions/production-overview.spec.ts",
                "src/app/views/dashboard/purchases/purchase-index/production-expenses.spec.ts",
                "src/app/views/dashboard/area-dashboards/area-dashboard.spec.ts"
              ]
            },
            "initial-import-module": {
              "tsConfig": "tsconfig.initial-import-tests.json",
              "watch": false,
              "browsers": "ChromeHeadless",
              "include": ["src/app/views/dashboard/initial-import/initial-shopify-import.spec.ts", "src/app/views/dashboard/initial-import/orders/imported-orders.spec.ts", "src/app/views/dashboard/order-workspace/order-workspace.spec.ts", "src/app/views/dashboard/photo-sessions/photo-sessions.spec.ts", "src/app/views/shared/components/image-preview/image-preview.component.spec.ts", "src/app/views/shared/pipes/date-shopify.pipe.spec.ts", "src/app/views/dashboard/shopify/orders/shared/order-status-stepper/order-status.model.spec.ts", "src/app/views/dashboard/migrations/shopify-order-migration.spec.ts"]
            },
            "personnel-module": {
              "tsConfig": "tsconfig.personnel-tests.json",
              "watch": false,
              "browsers": "ChromeHeadless",
              "include": [
                "src/app/views/dashboard/attendances/attendance-edit/attendance-edit.component.spec.ts",
                "src/app/views/dashboard/users/employees/employee-workflow.spec.ts",
                "src/app/views/dashboard/users/employees/employee-edit-page/employee-attendance-index/attendance-period.spec.ts",
                "src/app/views/dashboard/users/employees/employee-edit-page/employee-attendance-index/employee-attendance-index.component.spec.ts"
              ]
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
