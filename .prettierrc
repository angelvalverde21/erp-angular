{
  "printWidth": 70,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "printWidth": 250,
        "parser": "angular"
      }
    }
  ],
  "plugins": ["prettier-plugin-multiline-arrays"],
  "multilineArraysWrapThreshold": 1
}
